#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/coffeemail/rails/version"
require_relative "../tools/version_sync"

ROOT = File.expand_path("..", __dir__)
tag_index = ARGV.index("--tag")
problems = Tools::VersionSync.problems(
  version: CoffeeMail::Rails::VERSION,
  gemspec_version: Gem::Specification.load(File.join(ROOT, "coffeemail-rails.gemspec")).version.to_s,
  changelog: File.read(File.join(ROOT, "CHANGELOG.md")),
  tag: tag_index && ARGV[tag_index + 1],
)

problems.each { |problem| warn problem }
abort("Versões dessincronizadas") unless problems.empty?

puts "Versão sincronizada: #{CoffeeMail::Rails::VERSION}"
